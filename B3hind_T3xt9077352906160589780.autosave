// B3hind T3xt - Menu principal
// Los botones se definen en coordenadas de la IMAGEN ORIGINAL (1024 x 571),
// asi funcionan en cualquier resolucion de pantalla.

PImage fondo;
Boton btnJugar;
Boton btnConfig;
Boton btnCredits;
Boton btnSalir;

boolean debug = false;   // pon true para ver los rectangulos rojos (tecla D para alternar)

// Posicion y escala con la que se dibuja el fondo (se recalculan en calcularLayout)
float escalaFondo = 1;
float offsetX = 0;
float offsetY = 0;

// IMPORTANTE: fullScreen() debe ir en settings(), no en setup()
void settings() {
  fullScreen();
}

void setup() {
  fondo = loadImage("home.jpg");
  calcularLayout();

  // x, y, ancho, alto en pixeles de la imagen original
  btnJugar  = new Boton("JUGAR",         507, 361, 189, 53, fondo);
  btnConfig = new Boton("CONFIGURACION", 476, 427, 255, 54, fondo);
}

void draw() {
  background(0);
  calcularLayout();

  // Fondo (sin deformar, centrado)
  imageMode(CORNER);
  image(fondo, offsetX, offsetY, fondo.width * escalaFondo, fondo.height * escalaFondo);

  // Botones
  btnJugar.actualizar(mouseX, mouseY);
  btnConfig.actualizar(mouseX, mouseY);
  btnJugar.dibujar();
  btnConfig.dibujar();

  // Cursor de mano al pasar sobre un boton
  if (btnJugar.estaEncima(mouseX, mouseY) || btnConfig.estaEncima(mouseX, mouseY)) {
    cursor(HAND);
  } else {
    cursor(ARROW);
  }

  if (debug) {
    rectMode(CORNER);
    stroke(255, 0, 0);
    noFill();
    strokeWeight(2);
    rect(btnJugar.pantallaX(),  btnJugar.pantallaY(),  btnJugar.pantallaW(),  btnJugar.pantallaH());
    rect(btnConfig.pantallaX(), btnConfig.pantallaY(), btnConfig.pantallaW(), btnConfig.pantallaH());
  }
}

// Escala la imagen para que quepa en la pantalla manteniendo proporcion
void calcularLayout() {
  escalaFondo = min((float) width / fondo.width, (float) height / fondo.height);
  offsetX = (width  - fondo.width  * escalaFondo) / 2;
  offsetY = (height - fondo.height * escalaFondo) / 2;
}

void mousePressed() {
  if (btnJugar.estaEncima(mouseX, mouseY)) {
    btnJugar.presionar();
    println("JUGAR");
    // TODO: cambiar a la pantalla de juego
  }
  if (btnConfig.estaEncima(mouseX, mouseY)) {
    btnConfig.presionar();
    println("CONFIGURACION");
    // TODO: cambiar a la pantalla de configuracion
  }
}

void keyPressed() {
  if (key == 'd' || key == 'D') debug = !debug;
  if (key == ESC) exit();
}
